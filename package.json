{
  "name": "facultybridge",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "validate:quick": "npm run check && npm run test:browser",
    "validate": "npm run validate:quick && npm run test:e2e",
    "test:browser": "node tests/browser.mjs",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/test-local-files.mjs",
    "lint": "eslint \"apps/**/*.js\" \"packages/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"e2e/**/*.{js,mjs}\" \"playwright.config.js\" \".claude/hooks/**/*.{js,mjs}\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "eslint": "10.14.0"
  }
}
